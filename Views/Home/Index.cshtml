@{
    ViewData["Title"] = "Home Page";
}

@model IEnumerable<crud_web.Models.Person>
<div class="text-center">
   <table style="margin: 0 auto;">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Age</th>
            </tr>
        </thead>
        @foreach (var person in Model)
        {
            <tr>
                <td>@person.Id</td>
                <td>@person.Name</td>
                <td>@person.Age</td>
                <td class="nav-link text-dark"  asp-controller="Home" asp-action="Delete">Delete</td>
                <td class="nav-link text-dark"  asp-controller="Home" asp-action="Privacy" asp-route-id="@person.Id">Update</td>
            </tr>
        }
   </table>
</div>
